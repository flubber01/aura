{
  "id": "hello-tool",
  "name": "Hello Tool",
  "version": "1.0.0",
  "description": "Beispielmodul und Referenzimplementierung des AURA-Modulvertrags: zeigt Manifest, Lifecycle, Kontext-Rechte und zwei Aktionen.",
  "author": "AURA Core Team",
  "entry": "index.js",
  "type": "module",
  "permissions": ["log:write", "audit:write", "health:read", "storage:kv"],
  "configSchema": {
    "greeting": { "type": "string", "def": "Hello from AURA", "label": "Begrüßungstext" },
    "loud": { "type": "boolean", "def": false, "label": "Großbuchstaben-Modus" }
  },
  "capabilities": [
    { "action": "greet", "description": "Gibt eine config-basierte Begrüßung aus", "input": { "name": "string" } },
    { "action": "stats", "description": "Zeigt Aufrufstatistik + Systemgesundheit über den Kontext", "input": {} }
  ],
  "dependencies": ["aura-core"],
  "healthCheck": "healthCheck"
}
