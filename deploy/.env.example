# AURA environment — copy to deploy/.env and fill in. Never commit real keys.
# The systemd unit (deploy/aura.service) loads this via EnvironmentFile.

# HTTP port (default 8080)
PORT=8080

# production mode
NODE_ENV=production

# OmniRoute cloud lane (optional — without it, local lanes only)
# Budget cap enforced in code (default 20 EUR/month). data-private tasks
# ALWAYS route to local lanes regardless of this key.
OPENROUTER_API_KEY=

# Telegram control deck (optional — stays NOT-CONNECTED without token)
TELEGRAM_BOT_TOKEN=
